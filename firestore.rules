
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIRESTORE SECURITY RULES DOCUMENTATION
     *
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership model designed for a multi-tenant SaaS application 
     * where each 'Contractor' is isolated. Security is anchored on the Firebase Authentication UID, 
     * which serves as the top-level key for all contractor-related data.
     *
     * Data Structure:
     * The database follows a strictly hierarchical structure:
     * /contractorProfiles/{contractorId}
     *   /clients/{clientId}
     *   /quotes/{quoteId}
     *     /quoteItems/{quoteItemId}
     *   /customItems/{itemId}
     *   /templates/{templateId}
     */

    // --- Helper Functions ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user's UID matches the provided ID. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the document exists and the user is the owner. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    /** @description Validates that the contractorId in the data matches the path and the user. */
    function validatesContractorLink(userId) {
      return request.resource.data.contractorId == userId;
    }

    /** @description Ensures the contractorId field cannot be changed after creation. */
    function isContractorLinkImmutable() {
      return request.resource.data.contractorId == resource.data.contractorId;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the contractor's own business profile.
     * @path /contractorProfiles/{contractorId}
     */
    match /contractorProfiles/{contractorId} {
      allow get, list: if isOwner(contractorId);
      allow create: if isOwner(contractorId) && request.resource.data.id == contractorId;
      allow update: if isExistingOwner(contractorId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(contractorId);

      /**
       * @description Rules for clients managed by a specific contractor.
       */
      match /clients/{clientId} {
        allow get, list: if isOwner(contractorId);
        allow create: if isOwner(contractorId) && validatesContractorLink(contractorId);
        allow update: if isExistingOwner(contractorId) && isContractorLinkImmutable();
        allow delete: if isExistingOwner(contractorId);
      }

      /**
       * @description Rules for quotes generated by a contractor.
       */
      match /quotes/{quoteId} {
        allow get, list: if isOwner(contractorId);
        allow create: if isOwner(contractorId) && validatesContractorLink(contractorId);
        allow update: if isExistingOwner(contractorId) && isContractorLinkImmutable();
        allow delete: if isExistingOwner(contractorId);

        match /quoteItems/{quoteItemId} {
          allow get, list: if isOwner(contractorId);
          allow create: if isOwner(contractorId) && validatesContractorLink(contractorId) && request.resource.data.quoteId == quoteId;
          allow update: if isExistingOwner(contractorId) && isContractorLinkImmutable() && request.resource.data.quoteId == resource.data.quoteId;
          allow delete: if isExistingOwner(contractorId);
        }
      }

      /**
       * @description Rules for custom service items.
       */
      match /customItems/{itemId} {
        allow get, list: if isOwner(contractorId);
        allow create, update, delete: if isOwner(contractorId);
      }

      /**
       * @description Rules for reusable quote templates.
       */
      match /templates/{templateId} {
        allow get, list: if isOwner(contractorId);
        allow create, update, delete: if isOwner(contractorId);
      }
    }
  }
}
