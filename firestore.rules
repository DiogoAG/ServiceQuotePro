
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIRESTORE SECURITY RULES
     * 
     * Enforces user-ownership for management while allowing public 'get' 
     * access for shared quotes and business profiles.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /contractorProfiles/{contractorId} {
      // Allow anyone to 'get' a profile to see business info on a shared quote.
      // 'list' is strictly restricted to the owner.
      allow get: if true;
      allow list: if isOwner(contractorId);
      allow create: if isOwner(contractorId) && request.resource.data.id == contractorId;
      allow update: if isOwner(contractorId);
      allow delete: if isOwner(contractorId);

      match /clients/{clientId} {
        // Allow anyone to 'get' client info to render a shared quote.
        allow get: if true;
        allow list: if isOwner(contractorId);
        allow create: if isOwner(contractorId);
        allow update: if isOwner(contractorId);
        allow delete: if isOwner(contractorId);
      }

      match /quotes/{quoteId} {
        // Allow anyone to 'get' a quote if they have the ID (Shared Link).
        allow get: if true;
        allow list: if isOwner(contractorId);
        allow create: if isOwner(contractorId);
        allow update: if isOwner(contractorId);
        allow delete: if isOwner(contractorId);

        match /quoteItems/{quoteItemId} {
          allow get: if true;
          allow list, create, update, delete: if isOwner(contractorId);
        }
      }

      match /customItems/{itemId} {
        allow get, list, create, update, delete: if isOwner(contractorId);
      }

      match /templates/{templateId} {
        allow get, list, create, update, delete: if isOwner(contractorId);
      }
    }
  }
}
