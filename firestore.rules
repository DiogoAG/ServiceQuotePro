rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIRESTORE SECURITY RULES DOCUMENTATION
     *
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership model designed for a multi-tenant SaaS application 
     * where each 'Contractor' is isolated. Security is anchored on the Firebase Authentication UID, 
     * which serves as the top-level key for all contractor-related data.
     *
     * Data Structure:
     * The database follows a strictly hierarchical structure:
     * /contractorProfiles/{contractorId}
     *   /clients/{clientId}
     *   /quotes/{quoteId}
     *     /quoteItems/{quoteItemId}
     *
     * Key Security Decisions:
     * 1. Path-Based Authorization: Access is primary determined by whether the {contractorId} in the 
     *    document path matches the authenticated user's UID (request.auth.uid).
     * 2. Denormalization for Performance: To maintain high performance and avoid costly get() calls, 
     *    the 'contractorId' is denormalized into every subcollection document. Rules verify that 
     *    this internal ID matches the path and the user's identity.
     * 3. Prototyping Mode: While authorization is strictly enforced (who can access what), the specific 
     *    data types and secondary fields are not validated to allow for rapid frontend iteration.
     * 4. Relational Integrity: The rules enforce that critical relational links (like contractorId 
     *    and parent entity IDs) are set correctly on creation and remain immutable on update.
     */

    // --- Helper Functions ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user's UID matches the provided ID. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the document exists and the user is the owner. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    /** @description Validates that the contractorId in the data matches the path and the user. */
    function validatesContractorLink(userId) {
      return request.resource.data.contractorId == userId;
    }

    /** @description Ensures the contractorId field cannot be changed after creation. */
    function isContractorLinkImmutable() {
      return request.resource.data.contractorId == resource.data.contractorId;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the contractor's own business profile.
     * @path /contractorProfiles/{contractorId}
     * @allow (get) If the contractorId matches the user's UID.
     * @deny (list) If a user attempts to list profiles that do not belong to them.
     * @principle Ownership-based root access.
     */
    match /contractorProfiles/{contractorId} {
      allow get, list: if isOwner(contractorId);
      allow create: if isOwner(contractorId) && request.resource.data.id == contractorId;
      allow update: if isExistingOwner(contractorId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(contractorId);

      /**
       * @description Rules for clients managed by a specific contractor.
       * @path /contractorProfiles/{contractorId}/clients/{clientId}
       * @allow (create) If contractorId in data matches the path and the user is authenticated as that contractor.
       * @deny (update) If the user attempts to transfer a client to a different contractor.
       * @principle Relational integrity and path-based ownership.
       */
      match /clients/{clientId} {
        allow get, list: if isOwner(contractorId);
        allow create: if isOwner(contractorId) && validatesContractorLink(contractorId);
        allow update: if isExistingOwner(contractorId) && isContractorLinkImmutable();
        allow delete: if isExistingOwner(contractorId);
      }

      /**
       * @description Rules for quotes generated by a contractor.
       * @path /contractorProfiles/{contractorId}/quotes/{quoteId}
       * @allow (list) If the user is the owner of the parent contractor profile.
       * @deny (get) If the user is not authenticated or the contractorId does not match.
       * @principle Authorization independence via denormalized contractorId.
       */
      match /quotes/{quoteId} {
        allow get, list: if isOwner(contractorId);
        allow create: if isOwner(contractorId) && validatesContractorLink(contractorId);
        allow update: if isExistingOwner(contractorId) && isContractorLinkImmutable();
        allow delete: if isExistingOwner(contractorId);

        /**
         * @description Rules for individual line items within a quote.
         * @path /contractorProfiles/{contractorId}/quotes/{quoteId}/quoteItems/{quoteItemId}
         * @allow (create) If contractorId and quoteId in data match the hierarchy and the user is the owner.
         * @deny (update) If the quoteItemId or contractorId are modified.
         * @principle Deeply nested relational validation without parent lookups.
         */
        match /quoteItems/{quoteItemId} {
          allow get, list: if isOwner(contractorId);
          allow create: if isOwner(contractorId) && validatesContractorLink(contractorId) && request.resource.data.quoteId == quoteId;
          allow update: if isExistingOwner(contractorId) && isContractorLinkImmutable() && request.resource.data.quoteId == resource.data.quoteId;
          allow delete: if isExistingOwner(contractorId);
        }
      }
    }
  }
}