
{
  "entities": {
    "ContractorProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ContractorProfile",
      "type": "object",
      "description": "Represents a service contractor's business profile and default settings.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the ContractorProfile entity. (Primary Key)"
        },
        "businessName": {
          "type": "string",
          "description": "The official name of the contractor's business."
        },
        "licenseNumber": {
          "type": "string",
          "description": "The contractor's business license number, if applicable."
        },
        "address": {
          "type": "string",
          "description": "The business address of the contractor."
        },
        "phone": {
          "type": "string",
          "description": "The business phone number of the contractor."
        },
        "logoUrl": {
          "type": "string",
          "description": "URL or base64 data to the contractor's business logo."
        },
        "defaultTaxRate": {
          "type": "number",
          "description": "The default tax rate (as a decimal, e.g., 0.08 for 8%) applied to new quotes."
        },
        "defaultLaborRate": {
          "type": "number",
          "description": "The default hourly labor rate used for calculations in new quotes."
        },
        "quoteTerms": {
          "type": "string",
          "description": "Default terms and conditions displayed on quotes."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the contractor profile was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the contractor profile was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "businessName",
        "defaultTaxRate",
        "defaultLaborRate",
        "createdAt",
        "updatedAt"
      ]
    },
    "Client": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Client",
      "type": "object",
      "description": "Stores information about a client associated with a contractor.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Client entity. (Primary Key)"
        },
        "contractorId": {
          "type": "string",
          "description": "Reference to the ContractorProfile that owns this client."
        },
        "name": {
          "type": "string",
          "description": "The client's full name."
        },
        "email": {
          "type": "string",
          "description": "The client's email address.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "The client's phone number."
        },
        "address": {
          "type": "string",
          "description": "The client's address."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the client record was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the client record was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "contractorId",
        "name",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "Quote": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Quote",
      "type": "object",
      "description": "Represents a professional client quote generated by a contractor.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Quote entity. (Primary Key)"
        },
        "contractorId": {
          "type": "string",
          "description": "Reference to the ContractorProfile that created this quote."
        },
        "clientId": {
          "type": "string",
          "description": "Reference to the Client for whom this quote was prepared."
        },
        "date": {
          "type": "string",
          "description": "The date the quote was created.",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "description": "The current status of the quote.",
          "enum": ["draft", "sent", "approved", "rejected"]
        },
        "serviceCategory": {
          "type": "string",
          "description": "The category of service being quoted."
        },
        "subtotal": {
          "type": "number"
        },
        "taxTotal": {
          "type": "number"
        },
        "grandTotal": {
          "type": "number"
        },
        "scopeDescription": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "contractorId",
        "clientId",
        "date",
        "status",
        "serviceCategory",
        "subtotal",
        "grandTotal",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/contractorProfiles/{contractorId}",
        "definition": {
          "entityName": "ContractorProfile",
          "schema": {
            "$ref": "#/backend/entities/ContractorProfile"
          },
          "description": "Stores the business profile for a contractor.",
          "params": [
            {
              "name": "contractorId",
              "description": "The Firebase Authentication User ID."
            }
          ]
        }
      },
      {
        "path": "/contractorProfiles/{contractorId}/clients/{clientId}",
        "definition": {
          "entityName": "Client",
          "schema": {
            "$ref": "#/backend/entities/Client"
          },
          "description": "Clients managed by a specific contractor.",
          "params": [
            {
              "name": "contractorId",
              "description": "The owner's UID."
            },
            {
              "name": "clientId",
              "description": "The unique client ID."
            }
          ]
        }
      },
      {
        "path": "/contractorProfiles/{contractorId}/quotes/{quoteId}",
        "definition": {
          "entityName": "Quote",
          "schema": {
            "$ref": "#/backend/entities/Quote"
          },
          "description": "Quotes generated by a contractor.",
          "params": [
            {
              "name": "contractorId",
              "description": "The owner's UID."
            },
            {
              "name": "quoteId",
              "description": "The unique quote ID."
            }
          ]
        }
      }
    ]
  }
}
